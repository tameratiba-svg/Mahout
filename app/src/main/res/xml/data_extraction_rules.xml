<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: exclude the secrets store from both cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
        <exclude domain="file" path="s1/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
        <exclude domain="file" path="s1/" />
    </device-transfer>
</data-extraction-rules>
